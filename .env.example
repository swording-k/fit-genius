# Neon Postgres connection string. Required to enable the `stored` mode
# for the form-analysis endpoint and the user upsert in /api/auth/apple.
DATABASE_URL=

# Optional development bearer token. When set, /api/form-analyses
# requires `Authorization: Bearer <value>`. Used by simulator builds
# that cannot complete a real Apple Sign in flow.
FITGENIUS_DEV_SYNC_TOKEN=

# Active AI provider. Production defaults to MiniMax after migration.
AI_PROVIDER=minimax

# MiniMax OpenAI-compatible configuration. Never commit a real key;
# the production key lives only in the Vercel project environment.
MINIMAX_API_KEY=
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
MINIMAX_MODEL=MiniMax-M3

# Emergency rollback provider. Set AI_PROVIDER=aliyun to use it.
ALIYUN_API_KEY=

# 32+ character random string. Required in production to sign
# FitGenius session JWTs. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Apple Sign in audience. Must match the bundle id configured in
# the iOS app target. Defaults to the Vercel project env value.
APPLE_BUNDLE_ID=

# Optional. The issuer claim embedded in FitGenius session JWTs.
# Defaults to `fitgenius`. Keep it stable across deployments.
SESSION_ISSUER=fitgenius

# Optional. The publicly reachable URL where this backend is hosted
# (e.g. https://api.fitgenius.app). Surfaced for client diagnostics;
# not required by the server itself.
BACKEND_PUBLIC_URL=
